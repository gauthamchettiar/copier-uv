{
    "$schema": "https://docs.renovatebot.com/renovate-schema.json",
    "extends": [
        "config:recommended"
    ],
    "lockFileMaintenance": {
        "enabled": true
    },
    "schedule": [
        "at any time"
    ],
    "github-actions": {
        "fileMatch": [
            "^\\.github/workflows/.*\\.ya?ml$",
            "^project/\\.github/workflows/.*\\.jinja$"
        ]
    },
    "packageRules": [
        {
            "matchManagers": [
                "pep621"
            ],
            "groupName": "python-dependencies"
        },
        {
            "matchManagers": [
                "github-actions"
            ],
            "groupName": "github-actions"
        },
        {
            "matchFileNames": [
                "project/pyproject.toml.jinja"
            ],
            "groupName": "template-python-dependencies"
        },
        {
            "matchFileNames": [
                "project/.github/workflows/*.jinja"
            ],
            "groupName": "template-github-actions"
        }
    ],
    "customManagers": [
        {
            "customType": "regex",
            "managerFilePatterns": [
                "/^project/pyproject\\.toml\\.jinja$/"
            ],
            "matchStrings": [
                "\"(?<depName>[a-z0-9-]+)(?:\\[[\\w,]+\\])?\\s*(?:>=|==|~=|!=|<=|>|<)\\s*(?<currentValue>\\d+\\.\\d+(?:\\.\\d+)?)\""
            ],
            "datasourceTemplate": "pypi"
        }
    ]
}