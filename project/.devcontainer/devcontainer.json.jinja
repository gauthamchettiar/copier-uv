{
  "name": "{{ project_slug }} - Codespace",
  "image": "mcr.microsoft.com/devcontainers/python:{{ min_python_version }}",
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance",
        "ms-python.debugpy",
        "charliermarsh.ruff",
        "juggernautjp.less-toml",
        "yzhang.markdown-all-in-one"
      ],
      "settings": {
        "python.formatting.provider": "ruff",
        "python.analysis.typeCheckingMode": "basic"
      }
    }
  },
  "postCreateCommand": "python -m pip install --upgrade pip && python -m pip install uv && uv sync --all-groups && uv run pre-commit install || true",
  "remoteUser": "vscode"
}
